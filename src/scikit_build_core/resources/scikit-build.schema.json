        },
        "system-cmake": {
          "type": "string",
          "description": "The version of CMake found on the system. Takes a specifier set."
        },
        "cmake-wheel": {
          "type": "boolean",
          "description": "Whether a cmake wheel is known to be provided for this system."
        },
        "abi-flags": {
          "type": "string",
          "description": "A sorted string of the abi flags. Takes a regex."
        },
        "env": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "description": "A table of environment variables mapped to either string regexs, or booleans. Valid 'truthy' environment variables are case insensitive `true`, `on`, `yes`, `y`, `t`, or a number more than 0."
        },
        "config-setting": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "description": "A table of declared config-settings (tool.scikit-build.config-setting) mapped to either string regexs, or booleans. Matches the resolved value (env var, `-C`, or default)."
